{
  "name": "rice-ball",
  "author": "fyui001",
  "version": "1.0.3",
  "description": "Tool to remove code based on specific comments from node.js",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "rice-ball": "dist/bin/index.js"
  },
  "scripts": {
    "prebuild": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc",
    "pretest": "npm run build",
    "test": "node --test tests/cli.test.mjs",
    "prepublishOnly": "npm run build",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix"
  },
  "files": [
    "dist"
  ],
  "repository": "https://github.com/fyui001/rice-ball",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "enquirer": "^2.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
